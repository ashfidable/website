{
  "name": "ashfid.dev",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run generate:og && vp dev --port 3000",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "vp run clean && vp run generate:og && vp build && vp run verify:pages",
    "generate:og": "node scripts/generate-og-images.mjs",
    "verify:pages": "node scripts/verify-pages-build.mjs",
    "preview": "vp preview",
    "check": "tsc --noEmit",
    "format": "vp fmt",
    "generate-routes": "tsr generate",
    "cf:typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@iconify-json/devicon-plain": "^1.2.0",
    "@iconify-json/file-icons": "^1.2.0",
    "@iconify-json/logos": "^1.2.0",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.5",
    "@iconify-json/simple-icons": "^1.2.69",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@mdx-js/react": "^3.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.23",
    "@tanstack/react-start": "^1.168.40",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "fuse.js": "^7.5.0",
    "lucide-react": "^0.539.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "use-lanyard": "^2.0.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@mdx-js/rollup": "^3.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.25",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.10",
    "rehype-expressive-code": "^0.41.5",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "satori": "^0.29.0",
    "typeface-manrope": "^1.0.0",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-imagetools": "^12.0.0",
    "vite-plus": "catalog:",
    "wrangler": "^4.123.0",
    "yaml": "^2.9.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  }
}

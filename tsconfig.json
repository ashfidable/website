{
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.mdx", "vite.config.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "./worker-configuration.d.ts"],
    "paths": {
      "$components/*": ["./src/components/*"],
      "$assets/*": ["./src/assets/*"],
      "$styles/*": ["./src/styles/*"],
      "$utils/*": ["./src/utils/*"],
      "$content/*": ["./src/content/*"],
      "@/*": ["./src/*"]
    }
  }
}
